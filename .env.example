# ============================================================================
#  Military Asset Management System - production environment
#
#  Copy this file to `.env` for local use. For Render and Vercel, set the same
#  variable names in each service's dashboard (never commit a filled-in .env).
# ============================================================================

# ---- Database (Render backend) --------------------------------------------
# Aiven / any MySQL 8 host, as shown on the service's "Connection" page.
# Aiven requires TLS. The schema name must stay `military_asset_management`;
# the script in database/ creates it even when the provider names its own
# default database `defaultdb`.
DB_URL=jdbc:mysql://<db-host>:<db-port>/military_asset_management?ssl-mode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>
DB_POOL_SIZE=10

# ---- Security (Render backend) --------------------------------------------
# HS256 signing key, at least 32 characters. Generate a fresh one per
# environment: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# 12 hours. Keep this short in production so a leaked token expires quickly.
JWT_EXPIRATION_MS=43200000

# Comma separated list of browser origins allowed to call the API. The Vercel
# production URL must be listed here, otherwise the browser blocks every call.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://<your-app>.vercel.app
# Wildcards, so preview deployments are accepted without editing the list.
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app

# ---- Bootstrap admin (Render backend) -------------------------------------
# Only runs when the users table is empty, so it is safe to leave enabled.
BOOTSTRAP_ENABLED=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-admin-password

# ---- Server (Render backend) ----------------------------------------------
# Render injects PORT; the app must listen on it.
SERVER_PORT=8080
LOG_FILE=logs/app.log

# ---- Frontend (Vercel) ----------------------------------------------------
# Full URL of the API, but ONLY when it is on a different origin from the UI.
#
# The SPA and the API are deployed separately (Vercel + Render), so this points
# at the Render URL, for example:
#   VITE_API_BASE_URL=https://mams-backend-snii.onrender.com/api
# Leave it empty in local development, where Vite proxies /api instead.
#
# VITE_* values are inlined at build time, so changing this requires a redeploy.
VITE_API_BASE_URL=
# Only used by the local dev server.
VITE_PROXY_TARGET=http://localhost:8080
