# ---- API ------------------------------------------------------------------
# Leave VITE_API_BASE_URL empty in development: the Vite dev server proxies
# /api to VITE_PROXY_TARGET (see vite.config.js).
#
# For a production build served from a different origin, set the API ORIGIN
# with NO trailing /api, because the SPA appends its own /api/... paths:
#   VITE_API_BASE_URL=https://api.example.com
# A trailing /api here makes the app call /api/api/... and sign-in fails.
#
# This file holds no secrets: VITE_* values are inlined into the public bundle.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:8080

# ---- Optional dev-only login shortcuts -------------------------------------
# The login page can list usernames for one-click filling, which saves retyping
# during local testing. Only the USERNAMES belong here, and the page never shows
# or stores a password: you still type it. Put these in .env.local (git-ignored)
# rather than in this committed file, and never set them for a production build.
# VITE_DEV_ACCOUNT_ADMIN=
# VITE_DEV_ACCOUNT_COMMANDER=
# VITE_DEV_ACCOUNT_LOGISTICS=
