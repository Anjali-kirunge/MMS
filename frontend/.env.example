# ---- API ------------------------------------------------------------------
# Leave VITE_API_BASE_URL empty in development: the Vite dev server proxies
# /api to VITE_PROXY_TARGET (see vite.config.js). For a production build that
# is served from a different origin, set it to the full API URL.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:8080
